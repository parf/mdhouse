// mdhouse config — ~/.config/mdhouse/prefs.json ($XDG_CONFIG_HOME respected)
//
// Every key is optional, except that version 2 needs "readonly" and "autoRwRules". mdhouse writes
// this file itself (marks, -p, user-add, the settings page) as plain JSON, so comments you add are
// dropped on its next save. Its first save turns a version-1 file into version 2. A newer version,
// or version 2 with those lists missing or malformed, is never written and makes nothing writable.
{
  "version": 2,

  // Served on every start: `mdhouse <dir> -p`; forget with `mdhouse --rm <dir>`
  "saved": ["/home/you/notes", "/home/you/src/project"],
  // The saved ones mdhouse may write to: `mdhouse -p --rw <dir>`, or [RW] on the settings page
  "writable": ["/home/you/notes"],
  // The saved ones set read-only on the settings page — auto-rw never makes one writable
  "readonly": ["/home/you/src/project"],
  // Human names of saved ones, display only: `mdhouse <dir> -p --name "My Notes"` or the settings page;
  // `--name reset` or an empty name removes one. An unsaved project's name is not kept here
  "names": { "/home/you/notes": "My Notes" },

  // Every folder served from under these is writable without --rw, unless read-only: `mdhouse --auto-rw ~/src`
  // (switched off and on by settings.autoRw, on the settings page)
  "autoRwRules": ["/home/you/src"],
  // Version 1's place for those paths; version 2 keeps it empty, so an older mdhouse grants nothing by auto-rw
  "autoRw": [],

  // The Agent Bus integration: `mdhouse --agent-bus` / `--agent-bus off` / `--agent-bus <x.sock>`
  // `--agent-bus http://host:6767` — a remote daemon: socket holds the URL, token its credential (asked for)
  // default — the agents a page asks when it names none (<!-- AB: … -->); set on the settings page
  // filter — which agents the lists show: a regex per line, against the name without its #; [] — all
  "agentBus": { "enabled": false, "socket": "", "token": "", "default": [], "filter": ["^claude", "^codex", "^opencode"] },
  // A saved project's own Agent Bus, by its path; the settings page sets endpoint and default.
  // endpoint — a socket path or http(s)://host:port, nothing secret in it; none — the instance's
  // credential — for that endpoint, written here only, never through a page; a new endpoint drops it
  // default — the agents its pages ask when they name none; none — the instance's
  // A malformed entry makes that project's Agent Bus unavailable — never the instance's in its place
  "agentBusSpaces": {
    "/home/you/src/project": { "endpoint": "http://127.0.0.1:6767", "credential": "…", "default": ["#claude/project@host"] }
  },

  // Where to listen: `mdhouse -p --port 8080 --host 0.0.0.0`
  // Default 127.0.0.1:7777. MDHOUSE_PORT / MDHOUSE_HOST and --port / --host override it
  "server": { "port": 7777, "host": "127.0.0.1" },

  // Who may come in — doc/access.md. Both off until set, from the CLI only
  "access": {
    // `mdhouse --allow 192.168.1.0/24,10.0.0.5`; this machine always gets in; [] = everyone
    "allow": ["192.168.1.0/24"],
    // `mdhouse user-add login` / `user-rm login`; login -> argon2id hash, never the password
    "users": { "ann": "$argon2id$v=19$m=65536,t=2,p=1$…" }
  },

  // The settings page
  "settings": {
    // ✎ beside each title, opening edit:/full/path (and `e`)
    "editLink": true,
    // The ✎ link's URL scheme, no colon: "edit" (default) or e.g. "mdedit" to open Markdown in Typora
    // while `edit:` stays for your common editor. Not javascript, data, http, file, mailto …
    "editScheme": "edit",
    // Folders under the autoRw paths are writable
    "autoRw": true,
    // The name a signed Q&A reply carries (💬 👤me …) when a browser has set none of its own
    // (Settings → Your name, a cookie); "" — from git, else the login
    "me": ""
  },

  // Marks per served folder, by absolute path: ★ favorite, muted, ignored (hidden)
  // A path ending in / covers its whole subtree
  "roots": {
    "/home/you/notes": {
      "favorite": ["inbox.md", "plans/"],
      "muted": ["archive/"],
      "ignored": ["drafts/old.md"]
    }
  }
}
