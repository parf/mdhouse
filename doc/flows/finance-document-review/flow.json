{
  "schemaVersion": 1,
  "id": "finance-document-review",
  "title": "Review a financial document for inconsistencies",
  "family": "finance",
  "entry": "intake",
  "defaults": {
    "scope": "selected-document",
    "range": "explicit-baseline",
    "audience": "finance",
    "output": "financial-review-checklist",
    "destination": "Plans/flows/finance-document-review.md"
  },
  "evidence": {
    "required": [
      "supplied invoices statements or models",
      "terms dates amounts currency and line evidence",
      "tax fee and reconciliation basis or explicit missing"
    ],
    "missing": "block"
  },
  "example": "example.md",
  "steps": [
