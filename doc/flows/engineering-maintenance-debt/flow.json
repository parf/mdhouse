{
  "schemaVersion": 1,
  "id": "engineering-maintenance-debt",
  "title": "Review maintenance and technical debt",
  "family": "engineering",
  "entry": "inventory",
  "defaults": {
    "scope": "selected-project",
    "range": "explicit-baseline",
    "audience": "development",
    "output": "maintenance-backlog",
    "destination": "Plans/flows/engineering-maintenance-debt.md"
  },
  "evidence": {
    "required": [
      "code configuration and usage checks",
      "flag deprecation ownership and decision history",
      "documentation and source-linked TODO or FIXME records"
    ],
    "missing": "block"
  },
  "example": "example.md",
  "steps": [
    {
      "id": "inventory",
      "document": "workflow.md",
      "effect": "analysis",
      "approval": "none",
      "on": {
        "complete": {
          "kind": "step",
          "id": "verify-candidates"
        },
        "blocked": {
          "kind": "end",
          "status": "blocked"
        },
        "failed": {
          "kind": "end",
          "status": "failed"
        }
      }
    },
    {
      "id": "verify-candidates",
      "document": "workflow.md",
      "effect": "analysis",
      "approval": "none",
      "on": {
        "complete": {
          "kind": "step",
          "id": "prioritize"
        },
        "blocked": {
          "kind": "end",
          "status": "blocked"
        },
        "failed": {
          "kind": "end",
          "status": "failed"
        }
      }
    },
    {
      "id": "prioritize",
      "document": "workflow.md",
      "effect": "analysis",
      "approval": "none",
      "on": {
        "complete": {
          "kind": "step",
          "id": "report"
        },
        "blocked": {
          "kind": "end",
          "status": "blocked"
        },
        "failed": {
          "kind": "end",
          "status": "failed"
        }
      }
    },
    {
      "id": "report",
      "document": "workflow.md",
      "effect": "analysis",
      "approval": "none",
      "on": {
        "complete": {
          "kind": "end",
          "status": "complete"
        },
        "blocked": {
          "kind": "end",
          "status": "blocked"
        },
        "failed": {
          "kind": "end",
          "status": "failed"
        }
      }
    }
  ]
}
