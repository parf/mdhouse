{
  "schemaVersion": 1,
  "id": "incoming-change-review",
  "title": "Review a pull request or incoming change",
  "family": "incoming-change",
  "entry": "intake",
  "defaults": {
    "scope": "selected-document",
    "range": "explicit-baseline",
    "audience": "development",
    "output": "merge-readiness",
    "destination": "Plans/flows/incoming-change-review.md"
  },
  "evidence": {
    "required": [
      "PR or incoming patch with exact base and target",
      "checks reviews conflicts and threads",
      "ownership plans migration release and rollback evidence"
    ],
    "missing": "block"
  },
  "example": "example.md",
  "steps": [
    {
      "id": "intake",
      "document": "workflow.md",
      "effect": "analysis",
      "approval": "none",
      "on": {
        "complete": {
          "kind": "step",
          "id": "review"
        },
        "blocked": {
          "kind": "end",
          "status": "blocked"
        },
        "failed": {
          "kind": "end",
          "status": "failed"
        }
      }
    },
    {
      "id": "review",
      "document": "workflow.md",
      "effect": "analysis",
      "approval": "none",
      "on": {
        "complete": {
          "kind": "step",
          "id": "feedback"
        },
        "blocked": {
          "kind": "end",
          "status": "blocked"
        },
        "failed": {
          "kind": "end",
          "status": "failed"
        }
      }
    },
    {
      "id": "feedback",
      "document": "workflow.md",
      "effect": "analysis",
      "approval": "none",
      "on": {
        "complete": {
          "kind": "step",
          "id": "re-review"
        },
        "blocked": {
          "kind": "end",
          "status": "blocked"
        },
        "failed": {
          "kind": "end",
          "status": "failed"
        }
      }
    },
    {
      "id": "re-review",
      "document": "workflow.md",
      "effect": "analysis",
      "approval": "none",
      "on": {
        "complete": {
          "kind": "step",
          "id": "readiness"
        },
        "blocked": {
          "kind": "end",
          "status": "blocked"
        },
        "failed": {
          "kind": "end",
          "status": "failed"
        }
      }
    },
    {
      "id": "readiness",
      "document": "workflow.md",
      "effect": "analysis",
      "approval": "none",
      "on": {
        "complete": {
          "kind": "step",
          "id": "merge"
        },
        "blocked": {
          "kind": "end",
          "status": "blocked"
        },
        "failed": {
          "kind": "end",
          "status": "failed"
        }
      }
    },
    {
      "id": "merge",
      "document": "workflow.md",
      "effect": "merge",
      "approval": "explicit",
      "on": {
        "succeeded": {
          "kind": "step",
          "id": "post-merge"
        },
        "denied": {
          "kind": "end",
          "status": "cancelled"
        },
        "failed": {
          "kind": "end",
          "status": "failed"
        },
        "partial": {
          "kind": "end",
          "status": "partial"
        }
      }
    },
    {
      "id": "post-merge",
      "document": "workflow.md",
      "effect": "analysis",
      "approval": "none",
      "on": {
        "complete": {
          "kind": "step",
          "id": "report"
        },
        "blocked": {
          "kind": "end",
          "status": "blocked"
        },
        "failed": {
          "kind": "end",
          "status": "failed"
        }
      }
    },
    {
      "id": "report",
      "document": "workflow.md",
      "effect": "analysis",
      "approval": "none",
      "on": {
        "complete": {
          "kind": "end",
          "status": "complete"
        },
        "blocked": {
          "kind": "end",
          "status": "blocked"
        },
        "failed": {
          "kind": "end",
          "status": "failed"
        }
      }
    }
  ]
}
