{
  "schemaVersion": 1,
  "id": "engineering-project-health",
  "title": "Review project health",
  "family": "engineering",
  "entry": "inventory",
  "defaults": {
    "scope": "selected-project",
    "range": "explicit-baseline",
    "audience": "development",
    "output": "project-health",
    "destination": "Plans/flows/engineering-project-health.md"
  },
  "evidence": {
    "required": [
      "dependency and configuration inventory",
      "security and license evidence or explicit unavailable",
      "test CI and deprecation records"
    ],
    "missing": "block"
  },
  "example": "example.md",
  "steps": [
    {
      "id": "inventory",
      "document": "workflow.md",
      "effect": "analysis",
      "approval": "none",
      "on": {
        "complete": {
          "kind": "step",
          "id": "assess"
        },
        "blocked": {
          "kind": "end",
          "status": "blocked"
        },
        "failed": {
          "kind": "end",
          "status": "failed"
        }
      }
    },
    {
      "id": "assess",
      "document": "workflow.md",
      "effect": "analysis",
      "approval": "none",
      "on": {
        "complete": {
          "kind": "step",
          "id": "prioritize"
        },
        "blocked": {
          "kind": "end",
          "status": "blocked"
        },
        "failed": {
          "kind": "end",
          "status": "failed"
        }
      }
    },
    {
      "id": "prioritize",
      "document": "workflow.md",
      "effect": "analysis",
      "approval": "none",
      "on": {
        "complete": {
          "kind": "step",
          "id": "report"
        },
        "blocked": {
          "kind": "end",
          "status": "blocked"
        },
        "failed": {
          "kind": "end",
          "status": "failed"
        }
      }
    },
    {
      "id": "report",
      "document": "workflow.md",
      "effect": "analysis",
      "approval": "none",
      "on": {
        "complete": {
          "kind": "end",
          "status": "complete"
        },
        "blocked": {
          "kind": "end",
          "status": "blocked"
        },
        "failed": {
          "kind": "end",
          "status": "failed"
        }
      }
    }
  ]
}
