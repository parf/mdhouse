{
  "schemaVersion": 1,
  "id": "delivery",
  "title": "Update, review and prepare delivery",
  "family": "feature-delivery",
  "entry": "update",
  "defaults": {
    "scope": "selected-project",
    "range": "explicit-baseline",
    "audience": "operations",
    "output": "delivery-readiness",
    "destination": "Plans/flows/delivery.md"
  },
  "evidence": {
    "required": [
      "approved update task and owner",
      "exact base and target revisions",
      "test and independent review results",
      "migration release notes and rollback",
      "configured delivery destination and provider result"
    ],
    "missing": "block"
  },
  "example": "example.md",
