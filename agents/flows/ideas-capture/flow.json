{
  "schemaVersion": 1,
  "id": "ideas-capture",
  "title": "Capture and clarify an idea",
  "family": "ideas",
  "entry": "capture",
  "defaults": {
    "scope": "selected-document",
    "range": "explicit-baseline",
    "audience": "product",
    "output": "idea-brief",
    "destination": "Plans/flows/ideas-capture.md"
  },
  "evidence": {
    "required": [
      "original note and provenance",
      "problem audience outcome and constraints or explicit unknown",
      "owner and unanswered questions"
    ],
    "missing": "block"
  },
  "example": "example.md",
  "steps": [
    {
      "id": "capture",
      "document": "workflow.md",
      "effect": "analysis",
      "approval": "none",
      "on": {
        "complete": {
          "kind": "step",
          "id": "clarify"
        },
        "blocked": {
          "kind": "end",
          "status": "blocked"
        },
        "failed": {
          "kind": "end",
          "status": "failed"
        }
      }
    },
    {
      "id": "clarify",
      "document": "workflow.md",
      "effect": "analysis",
      "approval": "none",
      "on": {
        "complete": {
          "kind": "step",
          "id": "report"
        },
        "blocked": {
          "kind": "end",
          "status": "blocked"
        },
        "failed": {
          "kind": "end",
          "status": "failed"
        }
      }
    },
    {
      "id": "report",
      "document": "workflow.md",
      "effect": "analysis",
      "approval": "none",
      "on": {
        "complete": {
          "kind": "end",
          "status": "complete"
        },
        "blocked": {
          "kind": "end",
          "status": "blocked"
        },
        "failed": {
          "kind": "end",
          "status": "failed"
        }
      }
    }
  ]
}
