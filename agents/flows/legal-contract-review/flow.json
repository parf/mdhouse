{
  "schemaVersion": 1,
  "id": "legal-contract-review",
  "title": "Review a supplied contract",
  "family": "legal",
  "entry": "intake",
  "defaults": {
    "scope": "selected-document",
    "range": "explicit-baseline",
    "audience": "legal",
    "output": "contract-review",
    "destination": "Plans/flows/legal-contract-review.md"
  },
  "evidence": {
    "required": [
      "supplied contract versions and clause references",
      "parties dates money obligations and missing terms",
      "confidentiality jurisdiction and counsel review scope"
    ],
    "missing": "block"
  },
  "example": "example.md",
  "steps": [
    {
      "id": "intake",
      "document": "workflow.md",
      "effect": "analysis",
      "approval": "none",
      "on": {
        "complete": {
          "kind": "step",
          "id": "extract"
        },
        "blocked": {
          "kind": "end",
          "status": "blocked"
        },
        "failed": {
          "kind": "end",
          "status": "failed"
        }
      }
    },
    {
      "id": "extract",
      "document": "workflow.md",
      "effect": "analysis",
      "approval": "none",
      "on": {
        "complete": {
          "kind": "step",
          "id": "issues"
        },
        "blocked": {
          "kind": "end",
          "status": "blocked"
        },
        "failed": {
          "kind": "end",
          "status": "failed"
        }
      }
    },
    {
      "id": "issues",
      "document": "workflow.md",
      "effect": "analysis",
      "approval": "none",
      "on": {
        "complete": {
          "kind": "step",
          "id": "report"
        },
        "blocked": {
          "kind": "end",
          "status": "blocked"
        },
        "failed": {
          "kind": "end",
          "status": "failed"
        }
      }
    },
    {
      "id": "report",
      "document": "workflow.md",
      "effect": "analysis",
      "approval": "none",
      "on": {
        "complete": {
          "kind": "end",
          "status": "complete"
        },
        "blocked": {
          "kind": "end",
          "status": "blocked"
        },
        "failed": {
          "kind": "end",
          "status": "failed"
        }
      }
    }
  ]
}
