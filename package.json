{
  "name": "mdhouse",
  "version": "2.3.4",
  "description": "A Markdown workspace on your own machine — read every file, answer questions, triage issues and commit, together with your AI agents",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "bin": {
    "mdhouse": "./bin/mdhouse",
    "mdhouse-rag-sync": "./bin/mdhouse-rag-sync"
  },
  "homepage": "https://github.com/parf/mdhouse#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parf/mdhouse.git"
  },
  "bugs": {
    "url": "https://github.com/parf/mdhouse/issues"
  },
  "keywords": [
    "markdown",
    "workspace",
    "viewer",
    "docs",
    "documentation",
    "bun",
    "git",
    "markdown-server",
    "notes",
    "wiki",
    "preact",
    "ripgrep",
    "mermaid",
    "ai-agents",
    "claude-code"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "files": [
    "bin",
    "src",
    "agents",
    "doc",
    "!doc/*.png",
    "doc/agent-bus.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md",
    "tsconfig.json"
  ],
  "scripts": {
    "start": "bun run src/cli.ts",
    "dev": "XDG_CONFIG_HOME=.scratch/cfg bun --hot run src/cli.ts . --fg --port 7790",
    "prepublishOnly": "bun test && tsc --noEmit -p .",
    "test": "bun test"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "ai-agent-bus-sdk": "1.0.59",
    "dompurify": "3.4.17",
    "htmlparser2": "12.0.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^12.0.0",
    "preact": "^10.27.0",
    "sanitize-html": "2.18.1",
    "shiki": "^3.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/markdown-it": "^14.1.2",
    "@types/sanitize-html": "2.16.2",
    "typescript": "^7.0.2"
  }
}
